-- ЧАСТЬ 1: Создание таблиц (Структура из первой практической работы)
-- =========================================================================

DROP TABLE IF EXISTS Schedule CASCADE;
DROP TABLE IF EXISTS laboratories CASCADE;
DROP TABLE IF EXISTS Step3_Schedule CASCADE;

CREATE TABLE laboratories (
    lab_number INT PRIMARY KEY,
    Lab_name VARCHAR(100) NOT NULL,
    activity_type TEXT,
    head_of_lab VARCHAR(100),
    workplaces_count INT,
    has_project_equipment BOOLEAN,
    department_number INT
);

CREATE TABLE Schedule (
    group_number VARCHAR(20) NOT NULL,
    lab_number INT,
    discipline VARCHAR(100) NOT NULL,
    day_of_week VARCHAR(15) NOT NULL,
    lesson_number INT NOT NULL,
    CONSTRAINT pk_schedule PRIMARY KEY (group_number, day_of_week, lesson_number),
    CONSTRAINT fk_laboratory FOREIGN KEY (lab_number) REFERENCES laboratories (lab_number) ON DELETE CASCADE
);


