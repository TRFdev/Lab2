-- Вариант 18
-- Задание 1: выбрать все лаборатории 1 этажа, в которых есть проектное оборудование и число мест больше 20.
SELECT * 
FROM laboratories 
WHERE lab_number BETWEEN 100 AND 199 
  AND has_project_equipment = TRUE 
  AND workplaces_count > 20;

-- Задание 2: Выбрать дни недели и номера пар, на которых 106 лаборатория занята.
SELECT day_of_week, lesson_number 
FROM Schedule 
WHERE lab_number = 106;

-- Задание 3: Создать таблицу, содержащую данные 2 запроса с указанием данных из таблицы "Расписание"
CREATE TABLE Step3_Schedule AS 
SELECT group_number, lab_number, discipline, day_of_week, lesson_number 
FROM Schedule 
WHERE lab_number = 106;

-- Задание 4: добавить в созданную таблицу расписание для всех лабораторий 1 этажа.
INSERT INTO Step3_Schedule (group_number, lab_number, discipline, day_of_week, lesson_number)
SELECT group_number, lab_number, discipline, day_of_week, lesson_number 
FROM Schedule 
WHERE lab_number BETWEEN 100 AND 199;

-- Просмотр содержимого созданной таблицы перед изменениями
SELECT * FROM Step3_Schedule;

-- Задание 5: В Созданной таблице для всех занятий, проводимых на 5 паре, поменять местами 104 и 106 лаборатории.
UPDATE Step3_Schedule 
SET lab_number = CASE 
    WHEN lab_number = 104 THEN 106 
    WHEN lab_number = 106 THEN 104 
END
WHERE lesson_number = 5 AND lab_number IN (104, 106);

-- Задание 6: Из созданной таблицы удалить все записи для занятий, проводимых во вторник.
DELETE FROM Step3_Schedule 
WHERE LOWER(day_of_week) IN ('вторник', 'tuesday');

-- Просмотр итогового вида созданной таблицы после обновлений и удалений
SELECT * FROM Step3_Schedule;

-- Задание 7: Посчитать количество лабораторий на каждой кафедре, оснащенных проектным оборудованием и без него.
SELECT department_number, has_project_equipment, COUNT(*) AS labs_count 
FROM laboratories 
GROUP BY department_number, has_project_equipment
ORDER BY department_number, has_project_equipment;
